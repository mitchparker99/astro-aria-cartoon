---
import experiences from "../../collections/experiences.json";
import Button from "../button.astro";

// The first three entries are the current roles; the rest is past history and
// lives on the About page.
const current = experiences.filter((experience) => "summary" in experience);
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    Where I Work Now
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    Three current roles across health AI, resources data and automation
    services.
  </p>

  <div class="grid items-stretch w-full sm:grid-cols-2 md:grid-cols-3 gap-7 mt-7">
    {
      current.map((experience) => {
        return (
          <div class="relative flex items-stretch p-7 group rounded-2xl">
            <span class="absolute inset-0 z-20 block w-full h-full duration-300 ease-out bg-white border border-dashed dark:bg-neutral-950 rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:-translate-x-1 group-hover:-translate-y-1" />
            <span class="absolute inset-0 z-10 block w-full h-full duration-300 ease-out border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:translate-x-1 group-hover:translate-y-1" />
            <div class="relative z-30 duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
              <p class="text-xs tracking-widest uppercase text-neutral-400 dark:text-neutral-500">
                {experience.dates}
              </p>
              <h3 class="mt-2 mb-1 text-base font-bold leading-snug tracking-tight text-neutral-900 dark:text-neutral-100">
                {experience.company}
              </h3>
              <p class="mb-3 text-sm font-medium text-neutral-700 dark:text-neutral-300">
                {experience.role}
              </p>
              <p class="text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                {experience.summary}
              </p>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="flex items-center justify-center w-full py-5">
    <Button text="Read the full background" link="/about" />
  </div>
</section>
