---
const { dates, role, company, description } = Astro.props;
---

<div class="relative flex flex-col justify-start mb-8 last:mb-0">
  <p
    class="text-xs uppercase text-neutral-400 dark:text-neutral-500 tracking-widest"
  >
    {dates}
  </p>
  <h3 class="my-1 text-lg font-bold dark:text-neutral-100">{role}</h3>
  <p class="mb-1 text-sm font-medium dark:text-neutral-300">{company}</p>
  <p class="text-sm font-light leading-6 text-neutral-600 dark:text-neutral-400">
    {description}
  </p>
</div>
