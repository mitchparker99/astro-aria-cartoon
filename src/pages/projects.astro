---
import projects from "../collections/projects.json";
import PageHeading from "../components/page-heading.astro";
import Project from "../components/project.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title="Projects"
  description="Seven platforms Mitchell Parker designed, built and operated between 2022 and 2026 — commerce, business intelligence, algorithmic trading, 360° video, location data, enterprise integration and production voice AI."
>
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="My Projects"
      description="Seven platforms designed, built and operated sequentially between 2022 and 2026 — each one chosen to add a capability: commerce architecture, then BI, then automation, then enterprise integration, then production AI."
    />

    <div
      class="z-50 grid items-stretch w-full grid-cols-1 my-8 gap-7 sm:gap-5 sm:grid-cols-2"
    >
      {
        projects.map((project) => {
          return (
            <Project
              name={project.name}
              description={project.description}
              image={project.image}
              url={project.url}
            />
          );
        })
      }
    </div>
  </section>
</Layout>
